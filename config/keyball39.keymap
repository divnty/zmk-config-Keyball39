#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10
#define MOVE_NORMAL  <&kp MOUSE_MOVE_X>  // default layer’s pointer
#define MOVE_SLOW    <&kp MOUSE_MOVE_X_1>  // slower
#define MOVE_FAST    <&kp MOUSE_MOVE_X_3>  // faster

#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&sl { release-after-ms = <1000>; };

&lt { flavor = "tap-preferred"; };

&mt { flavor = "tap-preferred"; };

&sk {
};

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        ahm: ahomerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "aHOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <140>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
        };

        lpl: lpl {
            compatible = "zmk,behavior-hold-tap";
            label = "LPL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <205>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <0>;
        };

        kpmacr: kpmacr {
            compatible = "zmk,behavior-hold-tap";
            label = "KPMACR";
            #binding-cells = <2>;
            tapping-term-ms = <225>;
            flavor = "tap-preferred";
            bindings = <&parenth>, <&kp>;

            require-prior-idle-ms = <0>;
        };

        kpmacrquote: kpmacrquote {
            compatible = "zmk,behavior-hold-tap";
            label = "KPMACRQUOTE";
            #binding-cells = <2>;
            tapping-term-ms = <225>;
            flavor = "tap-preferred";
            bindings = <&dqt>, <&kp>;

            require-prior-idle-ms = <0>;
        };

        kpforw: kpforw {
            compatible = "zmk,behavior-hold-tap";
            label = "KPFORW";
            #binding-cells = <2>;
            tapping-term-ms = <225>;
            flavor = "tap-preferred";
            bindings = <&brack>, <&kp>;

            require-prior-idle-ms = <0>;
        };

        kpback: kpback {
            compatible = "zmk,behavior-hold-tap";
            label = "KPBACK";
            #binding-cells = <2>;
            tapping-term-ms = <225>;
            flavor = "tap-preferred";
            bindings = <&brace>, <&kp>;

            require-prior-idle-ms = <0>;
        };

        stickylayer: stickylayer {
            compatible = "zmk,behavior-hold-tap";
            label = "STICKYLAYER";
            bindings = <&sl>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <225>;
            flavor = "tap-preferred";
        };

        lplcapsword: lplcapsword {
            compatible = "zmk,behavior-hold-tap";
            label = "LPLCAPSWORD";
            bindings = <&caps_word>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <225>;
            flavor = "tap-preferred";
        };

        vd: vd {
            compatible = "zmk,behavior-mod-morph";
            label = "VD";
            bindings = <&kp LG(LC(LEFT))>, <&kp LG(LC(RIGHT))>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        volumedownleftbootloader: volumedownleftbootloader {
            compatible = "zmk,behavior-hold-tap";
            label = "VOLUMEDOWNLEFTBOOTLOADER";
            bindings = <&bootloader>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <225>;
            flavor = "tap-preferred";
        };

        volumuprightbootloader: volumuprightbootloader {
            compatible = "zmk,behavior-hold-tap";
            label = "VOLUMUPRIGHTBOOTLOADER";
            bindings = <&bootloader>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <225>;
            flavor = "tap-preferred";
        };

        scrollupleft: scrollupleft {
            compatible = "zmk,behavior-mod-morph";
            label = "SCROLLUPLEFT";
            bindings = <&msc SCRL_UP>, <&msc SCRL_LEFT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        scrolldownright: scrolldownright {
            compatible = "zmk,behavior-mod-morph";
            label = "SCROLLDOWNRIGHT";
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_RIGHT>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        spacedown: spacedown {
            compatible = "zmk,behavior-mod-morph";
            label = "SPACEDOWN";
            bindings = <&kp SPACE>, <&kp DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        enterup: enterup {
            compatible = "zmk,behavior-mod-morph";
            label = "ENTERUP";
            bindings = <&kp SPACE>, <&kp DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        tabgpt: tabgpt {
            compatible = "zmk,behavior-mod-morph";
            label = "TABGPT";
            bindings = <&kp TAB>, <&kp LS(LA(LC(D)))>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        righttop: righttop {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHTTOP";
            bindings = <&lpl LA(F4) LA(LS(B))>, <&lpl LA(F4) LS(LC(A))>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        pageup: pageup {
            compatible = "zmk,behavior-mod-morph";
            label = "PAGEUP";
            bindings = <&kp PAGE_UP>, <&kp HOME>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        altesc: altesc {
            compatible = "zmk,behavior-mod-morph";
            label = "ALTESC";
            bindings = <&kp LA(TAB)>, <&kp LA(ESCAPE)>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        esckpplus: esckpplus {
            compatible = "zmk,behavior-mod-morph";
            label = "ESCKPPLUS";
            bindings = <&kp ESCAPE>, <&kp KP_PLUS>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        pagedown: pagedown {
            compatible = "zmk,behavior-mod-morph";
            label = "PAGEDOWN";
            bindings = <&kp PAGE_DOWN>, <&kp END>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        homeend: homeend {
            compatible = "zmk,behavior-mod-morph";
            label = "HOMEEND";
            bindings = <&kp HOME>, <&kp END>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
        };

        backspaceleftarrow: backspaceleftarrow {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACELEFTARROW";
            bindings = <&kp BACKSPACE>, <&kp LEFT>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI|MOD_LGUI)>;
        };

        deleterightarrow: deleterightarrow {
            compatible = "zmk,behavior-mod-morph";
            label = "DELETERIGHTARROW";
            bindings = <&kp BACKSPACE>, <&kp LC(RIGHT)>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI|MOD_LGUI)>;
        };

        enteruparrow: enteruparrow {
            compatible = "zmk,behavior-mod-morph";
            label = "ENTERUPARROW";
            bindings = <&kp ENTER>, <&kp UP_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI|MOD_LGUI)>;
        };

        spacedownarrow: spacedownarrow {
            compatible = "zmk,behavior-mod-morph";
            label = "SPACEDOWNARROW";
            bindings = <&kp SPACE>, <&kp DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI|MOD_LGUI)>;
        };

        mkplayer: mkplayer {
            compatible = "zmk,behavior-hold-tap";
            label = "MKPLAYER";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        reset {
            bindings = <&sys_reset>;
            key-positions = <18 17 16 15>;
        };

        resett {
            bindings = <&sys_reset>;
            key-positions = <23 24 25 26>;
        };

        printscreen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <35 32>;
        };

        win5 {
            bindings = <&kp LG(N5)>;
            key-positions = <35 31>;
        };

        win6 {
            bindings = <&kp LG(NUMBER_6)>;
            key-positions = <35 30>;
        };

        win7 {
            bindings = <&kp LG(N7)>;
            key-positions = <35 29>;
        };
    };

    macros {
        email: email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp R &kp E &kp A &kp N &kp E &kp Y &kp AT &kp T &kp I &kp R &kp E &kp R &kp A &kp C &kp K &kp DOT &kp C &kp O &kp M>;
            label = "EMAIL";
        };

        wrkactjob: wrkactjob {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp R &kp K &kp A &kp C &kp T &kp J &kp O &kp B &kp SPACE &kp J &kp O &kp B &kp LPAR &kp B &kp R &kp E &kp A &kp N &kp E &kp Y &kp STAR &kp RPAR>;
            label = "WRKACTJOB";
        };

        select: select {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp S &kp E &kp L &kp E &kp C &kp T &kp SPACE &kp STAR &kp SPACE &kp F &kp R &kp O &kp M &kp SPACE &kp SEMI &kp LEFT &kp LEFT &kp SPACE &kp W &kp H &kp E &kp R &kp E &kp SPACE &kp NUMBER_1 &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp SPACE>;
            label = "SELECT";
        };

        string: string {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp I &kp R &kp E &kp S &kp UNDER &kp N2 &kp N2 &kp N8 &kp N6 &kp EXCL &kp LS(B) &kp LS(R)>;
            label = "STRING";
        };

        parenth: parenth {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RPAR &kp LEFT>;
            label = "PARENTH";
        };

        brack: brack {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "BRACK";
        };

        brace: brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT>;
            label = "BRACE";
        };

        ltgt: ltgt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp GT &kp LEFT>;
            label = "LTGT";
        };

        qt: qt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp SQT &kp LEFT>;
            label = "QT";
        };

        dqt: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES &kp DOUBLE_QUOTES &kp LEFT>;
            label = "NEW_MACRO";
        };

        rq: rq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp R &kp U &kp N &kp Q &kp R &kp Y &kp SPACE &kp Q &kp R &kp Y &kp F &kp I &kp L &kp E &kp LPAR &kp RPAR &kp LEFT>;
            label = "RQ";
        };

        signout: signout {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(PAUSE_BREAK) &kp N9 &kp N0 &kp ENTER>;
            label = "SIGNOUT";
        };

        paste2: paste2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(V)>,
                <&macro_wait_time 300>,
                <&kp DOWN &kp ENTER>;

            label = "PASTE2";
        };

        string2: string2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(H) &kp O &kp N &kp D &kp A &kp UNDER &kp LS(S) &kp LS(S) &kp AT &kp N2 &kp N2 &kp N8 &kp N6>;
            label = "STRING2";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "0";
            bindings = <
&lpl EXCLAMATION NUMBER_1  &lpl AT_SIGN NUMBER_2  &lpl HASH NUMBER_3  &lpl DOLLAR NUMBER_4  &lpl PERCENT N5                                                        &lpl AMPERSAND N7  &lpl ASTRK N8       &kpmacr 0 N9   &lpl RIGHT_PARENTHESIS N0  &lpl UNDERSCORE MINUS     
&kp Q                      &kp W                  &kp E               &kp R                 &kp T                                                                  &kp Y              &kp U               &lpl INSERT I  &kp O                      &lpl PAUSE_BREAK P        
&lpl LEFT_WIN A            &lpl LEFT_ALT S        &lpl LCTRL D        &lpl LEFT_SHIFT F     &stickylayer 3 G                                                       &lt 3 H            &lpl RIGHT_SHIFT J  &lpl RCTRL K   &lpl RIGHT_ALT L           &lpl RIGHT_WIN SEMICOLON  
&lt 5 Z                    &lt 6 X                &lplcapsword 0 C    &lt 1 V               &lpl LS(LC(B)) B  &kp TAB            &lt (1) LA(TAB)                   &kp N              &lt 5 M             &kp COMMA      &kp PERIOD                 &kpforw 0 SLASH           
&kp GRAVE                  &tog 2                 &kp LEFT            &kp RIGHT                                 &mkplayer 5 MB1    &kp ENTER         &kp SPACE                                         &kp UP_ARROW   &kp DOWN                   &tog 4                    
            >;
        };

        mouse {
            display-name = "2";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1          &bt BT_SEL 2           &bt BT_SEL 3  &bt BT_SEL 4                                                &trans     &trans  &trans          &trans          &trans           
&trans        &trans                &trans                 &trans        &trans                                                      &trans     &trans  &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_DOWN   
&trans        &trans                &trans                 &mo 2         &trans                                                      &trans     &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  
&trans        &trans                &kp LC(LEFT_BRACKET)   &kp LC(RIGHT_BRACKET)  &trans  &mkp MB5  &trans                   &trans  &trans     &msc SCRL_LEFT  &trans          &msc SCRL_RIGHT 
&trans        &trans                &trans                 &trans                &mkp LCLK &mkp RCLK &mkp MB3               &trans  &trans     &trans          &trans          &trans          
            >;
        };

        slowmouse {
            display-name = "3";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                            &trans    &trans  &trans               &trans               &trans            
&trans        &trans        &trans        &trans        &trans                                                  &trans    &trans  &msc SCRL_UP         &mmv (MOVE_Y(-400))  &msc SCRL_DOWN    
&trans        &trans        &trans        &trans        &trans                                                  &trans    &trans  &mmv (MOVE_X(-400))  &mmv MOVE_Y(400)     &mmv MOVE_X(400)  
&trans        &trans        &trans        &trans        &trans        &mkp MB5  &trans                   &trans &trans    &msc SCRL_LEFT       &trans               &msc SCRL_RIGHT   
&trans        &trans        &trans        &trans                      &mkp MB1  &mkp MB2  &trans         &trans &trans    &trans               &trans               &trans            
            >;
        };

        cc {
            display-name = "4";
            bindings = <
&string  &string2  &trans   &trans   &trans                                                        &kp KP_NUM    &trans  &trans      &trans       &trans       
&kp F1   &kp F2    &kp F3   &kp F4   &trans                                                        &trans        &trans  &kp LS(F1)  &kp LS(F2)   &kp LS(F3)   
&kp F5   &kp F6    &kp F7   &kp F8   &sk LEFT_SHIFT                                                &trans        &trans  &kp LS(F5)  &kp LS(F6)   &kp LS(F7)   
&kp F9   &kp F10   &kp F11  &kp F12  &kp LCTRL         &trans      &bt BT_SEL 4                      &trans        &kp LS(F9)  &kp LS(F10)  &kp LS(F11)  &kp LS(F12)  
&trans   &trans    &trans   &trans                     &kp ENTER   &kp SPACE   &trans                &trans        &trans      &trans       &trans       &trans       
            >;
        };

        Non-Standard {
            display-name = "0";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                                                         &trans     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0      
&kp TAB       &kp Q         &kp W         &kp E         &kp R                                                                &trans     &kp Y         &kp U         &kp I         &kp O             
&kp LALT      &kp A         &kp S         &kp D         &kp F                                                                &trans     &kp H         &kp J         &kp K         &kp L             
&kp Z         &kp X         &kp C         &kp V         &kp B             &kp LCTRL      &scrollupleft                       &trans     &kp N         &kp M         &kp COMMA     &kp PERIOD        
&kp HOME      &kp END       &kp LEFT      &kp RIGHT                       &kp SPACE      &kp LSHFT      &kp CLCK             &trans     &kp UP_ARROW  &kp DOWN      &kp LEFT_BRACKET  
            >;
        };

        Nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans    &trans    &trans     
&trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans    &kp UP    &trans     
&trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans    &kp LEFT  &kp DOWN   
&trans  &trans  &trans  &trans  &trans          &trans      &trans          &trans  &trans  &trans    &trans    &trans     
&trans  &trans  &trans  &trans                  &trans      &trans  &trans  &trans  &trans  &trans    &trans    &trans     
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &kp KP_NUM  &kp KP_DIVIDE  &kp KP_MULTIPLY  
&trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &kp N7      &kp N8         &kp N9           
&trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &kp N4      &kp N5         &kp N6           
&trans  &trans  &trans  &trans  &trans          &trans      &trans          &trans  &kp N1      &kp N2         &kp N3           &kp ENTER     
&trans  &trans  &trans  &trans                  &trans      &trans  &trans  &trans  &kp N0      &kp N0         &kp PERIOD       
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
